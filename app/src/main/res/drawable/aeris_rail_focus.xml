<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/aeris_focus_fill"/><corners android:radius="20dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/aeris_row_focus"/><corners android:radius="20dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/aeris_row_focus"/><corners android:radius="20dp"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="20dp"/></shape></item>
</selector>
