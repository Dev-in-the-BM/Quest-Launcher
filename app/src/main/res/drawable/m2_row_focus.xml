<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/m2_focus_fill"/><corners android:radius="2dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/m2_focus_fill"/><stroke android:width="2dp" android:color="@color/m2_focus_outline"/><corners android:radius="2dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/m2_focus_fill"/><corners android:radius="2dp"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/></shape></item>
</selector>
