<?xml version="1.0" encoding="utf-8"?>
<!-- A neutral light halo for the home-screen app-grid action. It intentionally
     avoids the accent/app colors used by focusable apps. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#52FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
